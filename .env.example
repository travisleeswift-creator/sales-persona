# Postgres connection string. Required on Vercel.
# Neon: use the pooled connection string and include sslmode=require.
# Leave blank for local dev and set ALLOW_PGLITE=1 instead.
DATABASE_URL=

# Local only. Uses embedded Postgres (PGlite) in .data/pglite when DATABASE_URL is empty.
# Ignored on Vercel. Do not enable this in the Vercel project settings.
ALLOW_PGLITE=1

# Optional. When OPENAI_API_KEY is set, persona lines are rewritten by an
# OpenAI-compatible chat model. If the key is missing or the call fails, the
# deterministic rule-based line is used. The app never requires this key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
